# ============================================
# Telegram Bot Configuration
# ============================================

# Single Bot Token (backward compatible)
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Multi-Bot Configuration (Optional)
# Uncomment and configure additional bots for scaling
# Supports up to 9 bot instances (BOT_TOKEN_1 through BOT_TOKEN_9)
# For most deployments, 2-3 bots are sufficient
# BOT_TOKEN_1=your_primary_bot_token_here
# BOT_TOKEN_2=your_secondary_bot_token_here
# BOT_TOKEN_3=your_tertiary_bot_token_here

# Single Bot Instance Override (Optional)
# Set this to run only a specific bot instance (e.g., BOT_INSTANCE=2 uses only BOT_TOKEN_2)
# Useful for testing or running separate deployments
# BOT_INSTANCE=1

# Admin User IDs (comma-separated, at least one required)
# Get your user ID from @userinfobot on Telegram
# Example: ADMIN_IDS=123456789 (single admin) or ADMIN_IDS=123456789,987654321 (multiple admins)
ADMIN_IDS=123456789

# Channel Configuration
# Option 1: Use Channel ID (recommended)
CHANNEL_ID=-1001234567890

# Option 2: Use Channel Username (alternative)
# CHANNEL_USERNAME=@your_channel_username

# ============================================
# Database Configuration
# ============================================

# Database file path
DB_PATH=catalog.db

# Enable WAL (Write-Ahead Logging) mode for better concurrent access
ENABLE_WAL_MODE=true

# Enable FTS5 full-text search for faster product searches
ENABLE_FTS_SEARCH=true

# Database connection pool size (for future optimization)
DB_POOL_SIZE=10

# Query cache TTL in seconds (300 = 5 minutes)
DB_CACHE_TTL=300

# ============================================
# Webhook Configuration (Optional)
# ============================================

# Set to true to use webhook mode instead of polling
USE_WEBHOOK=false

# Webhook URL (required if USE_WEBHOOK=true)
# WEBHOOK_URL=https://your-domain.com/webhook

# ============================================
# Bot Settings
# ============================================

# Default order contact username
ORDER_CONTACT=@FLYAWAYPEP

# ============================================
# Multi-Bot Deployment Guide
# ============================================
#
# SINGLE BOT (Default):
# - Use BOT_TOKEN for a single bot instance
# - All features work normally
#
# MULTI-BOT (Scaling):
# 1. Comment out BOT_TOKEN
# 2. Set BOT_TOKEN_1, BOT_TOKEN_2, BOT_TOKEN_3, etc.
# 3. Run migration: python scripts/migrate_db.py
# 4. Start multiple instances:
#    - Bot #1: Monitors channel, serves users
#    - Bot #2+: Serve users only
# 5. Admin broadcasts reach ALL users across ALL bots!
#
# Example:
# BOT_TOKEN_1=110201543:AAH...  # Primary bot (monitors channel)
# BOT_TOKEN_2=223412345:BBH...  # Secondary bot (users only)
# BOT_TOKEN_3=334523456:CCH...  # Tertiary bot (users only)
#
# ============================================
